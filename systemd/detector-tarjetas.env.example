# Variables de entorno del servicio detector-tarjetas.
#
# scripts/deploy.sh instala este contenido como /etc/default/detector-tarjetas
# SOLO si ese archivo no existe todavia: un redeploy nunca sobrescribe la
# configuracion local de la placa.
#
# La unidad systemd lo carga con:
#   EnvironmentFile=-/etc/default/detector-tarjetas
#
# CAMERA_URL tiene prioridad sobre CAMERA_INDEX cuando esta definida.
# Ejemplo de camara MJPEG/HTTP en la red local:
#   CAMERA_URL=http://192.168.1.8:8080/video
CAMERA_URL=
CAMERA_INDEX=0
PORT=8000
LOG_LEVEL=INFO
