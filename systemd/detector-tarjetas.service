[Unit]
Description=Detector de tarjetas electronicas (ORB) - Arduino UNO Q
Documentation=file:/home/arduino/detector-tarjetas/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=arduino
WorkingDirectory=/home/arduino/detector-tarjetas
Environment=PYTHONUNBUFFERED=1
Environment=PORT=8000
Environment=CAMERA_INDEX=0
Environment=LOG_LEVEL=INFO
ExecStart=/usr/bin/python3 -m app.server
Restart=always
RestartSec=3
# Acceso a /dev/video0 para el usuario del servicio
SupplementaryGroups=video
# Endurecimiento basico
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
